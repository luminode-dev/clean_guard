# 카메라 설정 템플릿
#
# 사용법:
#   cp .env.example .env
#   nano .env            # 실제 값으로 채운다
#   chmod 600 .env       # 비밀번호가 들어가므로 본인만 읽게
#
# .env는 .gitignore에 있어 깃에 올라가지 않는다.
# 여기 적은 값은 명령줄 인자로 덮어쓸 수 있다 (인자가 항상 우선).

# RTSP 주소. 아이디·비밀번호에 @ : / 같은 문자가 있으면 퍼센트 인코딩할 것
#   @ -> %40,  : -> %3A,  / -> %2F,  # -> %23
CAM_URL=rtsp://아이디:비밀번호@192.168.0.10:554/stream

# 출력 폴더명 (output/<이름>/ 에 이벤트가 쌓인다)
CAM_NAME=cam02

# 방송에 들어갈 장소명. 이 문구가 그대로 읽힌다
#   예) "정문 수거함 앞에 파란색 페트병을 무단으로 버리셨습니다. ..."
# 장소명을 넣지 않으려면 이 줄을 지운다
CAM_LOCATION=정문 수거함 앞

# 방송 목소리 (M1~M5 남성 / F1~F5 여성). 비우면 M4
TTS_VOICE=F2
# 합성 품질(디노이징 스텝, 1~100). 클수록 고품질·느림. 비우면 8
TTS_STEPS=8
# 방송 문구 앞에 장소명(대시보드 설치 위치 이름)을 넣을지. 1=넣음, 비우면 안 넣음
TTS_SAY_LOCATION=0

# --- 관제 서버 SRT 송출 (--push) ---
# streamid의 송출 비밀번호는 서버 C:\server\mediamtx\accounts.txt와 같아야 한다
SRT_HOST=cleanguard.duckdns.org
SRT_PORT=8890
SRT_STREAMID=publish:site02_cam2:jetson02:송출비번
# LTE 회선이면 400~600으로 올릴 것
SRT_LATENCY_MS=200

# --- 관제 서버 이벤트 전송 (--report) ---
# 장비 토큰은 서버 C:\server\app\device-tokens.txt와 같아야 한다 (jetson_handoff.md §1)
API_URL=https://cleanguard.duckdns.org
CG_DEVICE_TOKEN=장비토큰
DEVICE_ID=JT-GN-0002
SITE_ID=SITE-GN-0002
